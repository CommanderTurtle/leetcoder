# Optional overrides. Setup writes durable, per-user paths to
# ~/.config/leetcoder/config.json and keeps secrets outside this repository.
LEETCODER_CONFIG=
LEETCODER_API_URL=http://127.0.0.1:4749
LEETCODER_TOKEN_FILE=~/.config/leetcoder/token

# Native OMP executable and isolated profile used for delegated sessions.
OMP_COMMAND=omp
OMP_PROFILE=leetcoder

# OpenTelemetry remains disabled for the gateway and every delegated worker.
OTEL_SDK_DISABLED=true
