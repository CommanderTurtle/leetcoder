{
  "name": "@commanderturtle/leetcoder",
  "version": "0.2.0",
  "description": "Autonomous Hermes delegation to persistent, swarm-native oh-my-pi worktree sessions",
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "CommanderTurtle",
  "repository": {
    "type": "git",
    "url": "https://github.com/CommanderTurtle/leetcoder.git"
  },
  "homepage": "https://github.com/CommanderTurtle/leetcoder#readme",
  "bugs": {
    "url": "https://github.com/CommanderTurtle/leetcoder/issues"
  },
  "keywords": [
    "hermes-agent",
    "oh-my-pi",
    "omp",
    "mcp",
    "agent-delegation",
    "bun",
    "git-worktree"
  ],
  "bin": {
    "leetcoder": "./dist/cli.js"
  },
  "scripts": {
    "build": "bun build src/cli.ts src/mcp.ts --outdir dist --target bun --sourcemap=external",
    "check": "tsc --noEmit",
    "setup": "bun scripts/setup.ts",
    "start": "bun src/cli.ts serve",
    "doctor": "bun src/cli.ts doctor"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "src",
    "scripts",
    "rules",
    "skills",
    ".env.example",
    "leetcoder.config.example.json",
    "README.md",
    "LICENSE"
  ],
  "overrides": {
    "@hono/node-server": ">=2.0.5",
    "fast-uri": ">=3.1.5",
    "hono": ">=4.12.34"
  }
}
